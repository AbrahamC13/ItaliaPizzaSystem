                  <TableColumn fx:id="tcMaterno" prefWidth="81.0" text="A.Materno" />
                  <TableColumn fx:id="tcTelefono" prefWidth="68.0" text="Teléfono" />
                  <TableColumn fx:id="tcCorreo" prefWidth="84.0" text="Correo" />
                  <TableColumn fx:id="tcCodigoPostal" prefWidth="49.0" text="CP" />
                  <TableColumn fx:id="tcDireccion" prefWidth="160.0" text="Direccion" />
              </columns>
            </TableView>
         </children>
      </VBox>
   </children>
