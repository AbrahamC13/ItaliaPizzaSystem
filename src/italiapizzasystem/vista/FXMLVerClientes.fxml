<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane id="AnchorPane" prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="italiapizzasystem.controlador.FXMLVerClientesController">
   <children>
      <AnchorPane prefHeight="82.0" prefWidth="1280.0" style="-fx-background-color: #004D57;">
         <children>
            <Button layoutX="14.0" layoutY="16.0" mnemonicParsing="false" onAction="#btnClicRegresar" prefHeight="51.0" prefWidth="50.0" style="-fx-background-radius: 45; -fx-background-image: url('/italiapizzasystemRecursos/imagenes/regreso.png'); -fx-background-position: center; -fx-background-repeat: no-repeat; -fx-background-size: cover;" />
         </children>
      </AnchorPane>
      
      <AnchorPane layoutY="82.0" prefHeight="641.0" prefWidth="1280.0" style="-fx-background-color: #FAF8F1;">
         <children>
            <Label layoutX="47.0" layoutY="42.0" text="Gestión de clientes" textFill="#004d57">
               <font>
                  <Font name="Arial Black" size="30.0" />
               </font>
            </Label>
            
            <Label layoutX="62.0" layoutY="116.0" text="Buscar cliente:">
               <font>
                  <Font name="Arial" size="20.0" />
               </font>
            </Label>
            <TextField fx:id="tfNombre" layoutX="242.0" layoutY="110.0" prefHeight="36.0" prefWidth="407.0" promptText="Nombre cliente" style="-fx-background-radius: 20;" />
            
            <Button layoutX="1020.0" layoutY="114.0" mnemonicParsing="false" onAction="#btnAgregarCliente" prefHeight="51.0" prefWidth="230.0" style="-fx-background-radius: 30 30 0 0; -fx-background-color: #72FF47;" text="Agregar cliente">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Button>
            
            <TableView fx:id="tvClientes" layoutX="47.0" layoutY="165.0" prefHeight="375.0" prefWidth="1203.0" style="-fx-background-radius: 10px;">
              <columns>
                <TableColumn fx:id="tcNombre" prefWidth="160.0" text="Nombre" />
                <TableColumn fx:id="tcPaterno" prefWidth="160.0" text="A. Paterno" />
                <TableColumn fx:id="tcMaterno" prefWidth="160.0" text="A.Materno" />
                <TableColumn fx:id="tcTelefono" prefWidth="140.0" text="Teléfono" />
                <TableColumn fx:id="tcCorreo" prefWidth="200.0" text="Correo" />
                <TableColumn fx:id="tcCodigoPostal" prefWidth="100.0" text="CP" />
                <TableColumn fx:id="tcDireccion" prefWidth="281.0" text="Direccion" />
              </columns>
            </TableView>
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
