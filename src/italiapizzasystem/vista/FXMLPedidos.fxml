<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.text.*?>
<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane id="AnchorPane" prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="italiapizzasystem.controlador.FXMLPedidosController">
   <children>
      <AnchorPane prefHeight="82.0" prefWidth="1280.0" style="-fx-background-color: #004D57;">
         <children>
            <Button fx:id="btn_Regresar" layoutX="14.0" layoutY="16.0" mnemonicParsing="false" onAction="#btn_ClicRegresar" prefHeight="51.0" prefWidth="50.0" style="-fx-background-radius: 45; -fx-background-image: url('/italiapizzasystemRecursos/imagenes/regreso.png'); -fx-background-position: center; -fx-background-repeat: no-repeat; -fx-background-size: cover;" />
         </children>
      </AnchorPane>
      <AnchorPane layoutY="82.0" prefHeight="641.0" prefWidth="1280.0" style="-fx-background-color: #FAF8F1;">
         <children>
            <TableView fx:id="tbl_Pedidos" layoutX="47.0" layoutY="165.0" prefHeight="375.0" prefWidth="1203.0" style="-fx-background-radius: 10px;">
              <columns>
                <TableColumn fx:id="col_IdPedido" text="ID Pedido" />
                <TableColumn fx:id="col_NombreCliente" prefWidth="309.0" text="Nombre cliente" />
                  <TableColumn fx:id="col_Direccion" prefWidth="303.0" text="Dirección" />
                  <TableColumn fx:id="col_Fecha" prefWidth="193.0" text="Fecha" />
                  <TableColumn fx:id="col_Status" prefWidth="175.0" text="Estatus " />
                  <TableColumn fx:id="col_Editar" prefWidth="142.0" />
              </columns>
            </TableView>
            <Label layoutX="62.0" layoutY="116.0" text="Buscar por cliente:">
               <font>
                  <Font name="Arial" size="20.0" />
               </font></Label>
            <TextField fx:id="tf_NombreCliente" layoutX="242.0" layoutY="110.0" prefHeight="36.0" prefWidth="407.0" promptText="Nombre de cliente" style="-fx-background-radius: 20;" />
            <Button fx:id="btn_NuevoPedido" layoutX="1020.0" layoutY="91.0" mnemonicParsing="false" onAction="#btn_ClicNuevoPedido" prefHeight="51.0" prefWidth="230.0" style="-fx-background-radius: 30; -fx-background-color: #72FF47;" text="Nuevo pedido">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font></Button>
            <Label layoutX="47.0" layoutY="42.0" text="Sección de pedidos" textFill="#004d57">
               <font>
                  <Font name="Arial Black" size="30.0" />
               </font>
            </Label>
            <Button fx:id="btn_Exportar" layoutX="47.0" layoutY="557.0" mnemonicParsing="false" onAction="#btn_ClicExportarInformacionPedido" prefHeight="51.0" prefWidth="284.0" style="-fx-background-radius: 50; -fx-background-color: #00A1B2;" text="Exportar información de pedidos" textFill="WHITE">
               <font>
                  <Font name="Arial" size="16.0" />
               </font></Button>
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
